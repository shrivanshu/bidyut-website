# Bidyut Website - Safe .htaccess for GoDaddy VPS

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Serve WebP images when browser supports them
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} (.*)\.(jpe?g|png)$ [NC]
  RewriteCond %1.webp -f
  RewriteRule ^(.*)\.(jpe?g|png)$ $1.webp [T=image/webp,L]
  
  # SPA fallback: serve index.html for client-routed paths
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html

<IfModule mod_headers.c>
    # Immutable long-cache for fingerprinted assets (Vite outputs hashed filenames)
    <FilesMatch "[-_.][A-Za-z0-9]{6,}\.(?:js|mjs|css|wasm|svg|png|jpg|jpeg|gif|webp|avif|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Long cache for other static assets (images, fonts, video)
    <FilesMatch "\.(?:png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot|mp4|webm|ogg|ogv|mov)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # HTML: avoid caching to enable fast updates
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Disable ETag to avoid revalidation overhead (immutable assets handle freshness)
FileETag None
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>

# CORS for fonts (prevents blocking when served cross-origin/CDN)
<IfModule mod_headers.c>
    <FilesMatch "\.(?:ttf|ttc|otf|eot|woff|woff2)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ---------------------------------------------
# Security headers (safe defaults)
# ---------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # HSTS only on HTTPS to reduce an extra round-trip on future visits
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# Don’t force Keep-Alive header here (Apache/HTTP/2 manages it better).

# Ensure index.html is the default directory index
DirectoryIndex index.html
